{
  "name": "v0-project",
  "version": "1.0.0",
  "description": "ProfileRelaunch web application – Google Business Profile recovery and review protection",
  "main": "index.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:pay-env-05": "vitest run --config test/pay-env-05/vitest.config.ts",
    "typecheck:pay-env-05": "tsc --noEmit -p test/pay-env-05/tsconfig.json",
    "dev:admin": "npm run dev --workspace=@profilerelaunch/admin",
    "build:admin": "npm run build --workspace=@profilerelaunch/admin",
    "start:admin": "npm run start --workspace=@profilerelaunch/admin",
    "typecheck:admin": "npm run typecheck --workspace=@profilerelaunch/admin",
    "test:admin": "npm run test --workspace=@profilerelaunch/admin",
    "check:admin": "npm run test:admin && npm run typecheck:admin",
    "rehearse:recovery": "npm run test --workspace=@profilerelaunch/admin -- lib/recovery/",
    "release:admin-check": "node scripts/release-admin-check.mjs",
    "release:customer-check": "node scripts/release-customer-check.mjs",
    "smoke:admin": "node scripts/smoke-admin.mjs",
    "smoke:marketing": "node scripts/smoke-marketing.mjs",
    "dev:customer": "npm run dev --workspace=@profilerelaunch/customer",
    "build:customer": "npm run build --workspace=@profilerelaunch/customer",
    "start:customer": "npm run start --workspace=@profilerelaunch/customer",
    "typecheck:customer": "npm run typecheck --workspace=@profilerelaunch/customer",
    "test:customer": "npm run test --workspace=@profilerelaunch/customer",
    "smoke:customer": "node scripts/smoke-customer.mjs",
    "dev:telloya": "npm run dev --workspace=@profilerelaunch/telloya",
    "build:telloya": "npm run build --workspace=@profilerelaunch/telloya",
    "start:telloya": "npm run start --workspace=@profilerelaunch/telloya",
    "typecheck:telloya": "npm run typecheck --workspace=@profilerelaunch/telloya",
    "test:telloya": "npm run test --workspace=@profilerelaunch/telloya"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NabarunDas/reputedefend-web.git"
  },

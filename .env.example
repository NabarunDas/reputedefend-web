# ProfileRelaunch enquiry delivery (server-side)
#
# Display brand is ProfileRelaunch. Operational mailboxes remain on
# reputedefend.com until Workspace/Resend is migrated. Do not invent a
# @profilerelaunch.com From address here.

# Copy this file to `.env.local` and fill in real values locally or in the host.
# Never commit secrets.

# Required for live email delivery
RESEND_API_KEY=re_xxxxxxxx
ENQUIRY_FROM_EMAIL=enquiries@reputedefend.com
ENQUIRY_TO_EMAIL=owner@example.com

# Optional extra Reply-To in addition to the customer's email
# ENQUIRY_REPLY_TO_EMAIL=team@reputedefend.com

# Optional customer acknowledgement. Leave unset/false unless you have
# explicitly decided to send a receipt email. Internal delivery is the default.
# ENQUIRY_SEND_CUSTOMER_ACK=false

# Optional Google Analytics 4. Leave unset to keep analytics off.
# Do not invent a measurement ID. Analytics loads only after explicit consent.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional Search Console HTML-tag verification. Leave unset if unused.
# GOOGLE_SITE_VERIFICATION=

# Supabase — server-side only. Do not prefix with NEXT_PUBLIC_.
# Required only when server code talks to the database. The site still
# builds and the current enquiry flow still works when these are unset.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Enables persistent DB-backed Get Help case intake.
# Keep false/unset in Production until production Supabase is ready.
# Server-side only. Do not prefix with NEXT_PUBLIC_.
CASE_PERSISTENCE_ENABLED=false

# Enables /start-monitoring and /api/monitoring persistence.
# Keep false/unset in Production until Preview enablement is approved.
# Server-side only. Do not prefix with NEXT_PUBLIC_.
MONITORING_PERSISTENCE_ENABLED=false
